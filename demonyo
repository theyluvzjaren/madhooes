    	clickSound:Play()
    
    	openBtn.Visible = false
    	MainFrame.Visible = true
    
    	local currentPos = MainFrame.Position
    	local targetPos = UDim2.new(currentPos.X.Scale, currentPos.X.Offset - (27+73), currentPos.Y.Scale, currentPos.Y.Offset - (10+40))
    
    	local restoreTween = TweenService:Create(MainFrame, TweenInfo.new(0.(10+15), Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
    		Size = originalSize,
    		Position = targetPos,
    		BackgroundTransparency = 0
    	})
    
    	restoreTween:Play()
    	restoreTween.Completed:Connect(function()
    		minimized = false
    	end)
    end)
    
    
    
    
    
    CloseBtn.MouseButton1Click:Connect(function()
    	clickSound:Play()
    	if ScreenGui then ScreenGui:Destroy() end
    end)
    
    print(__G[0x4b])
    
    
end

