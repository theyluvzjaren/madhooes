			chatEvent.SayMessageRequest:FireServer(message, __S({3,46,46}))
		end
	end
end


local function isPlayerCarried(targetPlayer)
	if not targetPlayer.Character then return false end

	for _, descendant in ipairs(targetPlayer.Character:GetDescendants()) do
		if descendant:IsA(__S({8,45,43,44,54,11,44,49,54,35,44,33,39})) then
			if descendant.Part0 and descendant.Part0:IsDescendantOf(localPlayer.Character) then
				return true
			elseif descendant.Part1 and descendant.Part1:IsDescendantOf(localPlayer.Character) then
				return true
			end
		end
	end
	return false
end


local function executeSequence(targetPlayer)
	if not targetPlayer or not targetPlayer.Character or not targetPlayer.Character:FindFirstChild(__S({10,55,47,35,44,45,43,38,16,45,45,54,18,35,48,54})) then
		warn(__S({10,43,44,38,43,98,47,35,42,35,44,35,50,98,35,44,37,98,33,42,35,48,35,33,54,39,48,98,44,37,98,54,35,48,37,39,54,98,50,46,35,59,39,48,99}))
		return
	end

	local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
	local rootPart = character:WaitForChild(__S({10,55,47,35,44,45,43,38,16,45,45,54,18,35,48,54}))
	local targetName = targetPlayer.Name

	
	local noclipConnection
	noclipConnection = RunService.Stepped:Connect(function()
		if character then
			for _, part in ipairs(character:GetDescendants()) do
				if part:IsA(__S({0,35,49,39,18,35,48,54})) then
					part.CanCollide = false
				end
			end
		end
	end)

	
	rootPart.CFrame = targetPlayer.Character.HumanoidRootPart.CFrame
	task.wait(0.1)

	
	sendChat(__S({109,33,35,48,48,59,98}) .. targetName)

	
	local carrySuccess = false
	local timeout = 0
	while timeout < 15 do
		task.wait(0.05)
		timeout = timeout + 1
		if isPlayerCarried(targetPlayer) then
			carrySuccess = true
			break
		end
	end

	if not carrySuccess then
		sendChat(__S({109,33,35,48,48,59,98}) .. targetName)
		task.wait(0.2)
	end

	
	local flyVelocity = Instance.new(__S({0,45,38,59,20,39,46,45,33,43,54,59}))
	flyVelocity.Velocity = Vector3.new(0, 800, 0)
	flyVelocity.MaxForce = Vector3.new(0, 10000000, 0)
	flyVelocity.Parent = rootPart

	local startY = rootPart.Position.Y
	while rootPart.Position.Y - startY < 2000 do
		task.wait()
		if not character or not rootPart then break end
	end

	flyVelocity:Destroy()
	task.wait(0.05)

	
	sendChat(__S({109,38,48,45,50}))
	task.wait(0.2)

	
	rootPart.CFrame = getSpawnCFrame()
	task.wait(0.1)

	
	if noclipConnection then
		noclipConnection:Disconnect()
	end
end





